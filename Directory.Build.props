<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <Version>4.5.5</Version>
    <AssemblyVersion>4.5.5.0</AssemblyVersion>
    <FileVersion>4.5.5.0</FileVersion>
    <InformationalVersion>4.5.5</InformationalVersion>
    <!-- Settings palette refresh preserves the resolved light/dark theme. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Lumen</Product>
    <Company>Lumen</Company>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>

